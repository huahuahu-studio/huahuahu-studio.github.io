---
import Base from '../layouts/Base.astro';
---

<Base
  lang="zh"
  title="404 — Huahuahu Studio"
  description="找不到页面 / Page not found"
  noindex
>
  <section class="not-found wrap">
    <p class="eyebrow orange" style="justify-content:center">
      404 / NOT FOUND
    </p>
    <h1>这一页，暂时走丢了。</h1>
    <p lang="en">This page has wandered off.</p>
    <a href="/zh/" class="button button-dark">
      回到首页
    </a>{' '}
    <a href="/en/" class="button">
      Home in English →
    </a>
  </section>
</Base>
