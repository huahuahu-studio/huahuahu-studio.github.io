---
import Base from '../../layouts/Base.astro';
import Document from '../../components/Document.astro';
import { languages, copy, type Language } from '../../data/site';
import { websitePrivacy } from '../../data/documents';
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Language;
const document = websitePrivacy[lang];
---

<Base
  lang={lang}
  title={document.title + ' — ' + copy[lang].brand}
  description={document.lead}
  path="privacy"
>
  <Document lang={lang} document={document} active="privacy" />
</Base>
