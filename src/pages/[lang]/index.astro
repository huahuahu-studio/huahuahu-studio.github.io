---
import Base from '../../layouts/Base.astro';
import Home from '../../components/Home.astro';
import { languages, copy, type Language } from '../../data/site';
import { apps, featuredApp } from '../../data/apps';
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Language;
---

<Base
  lang={lang}
  title={copy[lang].brand + ' — ' + copy[lang].footerLine}
  description={copy[lang].heroDescription}
>
  <Home lang={lang} apps={apps} featuredApp={featuredApp} />
</Base>
