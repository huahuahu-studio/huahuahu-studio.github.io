---
import Base from '../../layouts/Base.astro';
import { languages, copy, email, type Language } from '../../data/site';
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Language;
const t = copy[lang];
---

<Base
  lang={lang}
  title={t.about + ' — ' + t.brand}
  description={t.aboutLead}
  path="about"
>
  <section class="about-page wrap">
    <p class="eyebrow orange">A SMALL INDEPENDENT STUDIO</p>
    <h1>{t.aboutTitle}</h1>
    <div class="about-text">
      <p class="large-text">{t.aboutLead}</p>
      <p>{t.aboutBody}</p>
      <a class="text-link" href={'mailto:' + email}>
        {email} ↗
      </a>
    </div>
    <div class="about-mark" aria-hidden="true">
      ✳
    </div>
  </section>
</Base>
