---
import type { Language } from '../data/site';
import type { AppConfig } from '../data/apps';
interface Props {
  lang: Language;
  app: AppConfig;
  compact?: boolean;
}
const { lang, app, compact = false } = Astro.props;
const content = app.content[lang];
const scene = content.scene;
---

{scene ? (
  <div class:list={['phone-scene', { compact }]}>
    <div class="scene-orbit" aria-hidden="true"></div>
    <span class="scene-spark spark-one" aria-hidden="true">
      ✳
    </span>
    <span class="scene-spark spark-two" aria-hidden="true">
      ✦
    </span>
    <div class="phone phone-back">
      <img
        src={scene.back.src}
        width={scene.back.width}
        height={scene.back.height}
        alt={scene.back.alt}
        fetchpriority="high"
      />
    </div>
    <div class="phone phone-front">
      <img
        src={scene.front.src}
        width={scene.front.width}
        height={scene.front.height}
        alt={scene.front.alt}
        fetchpriority="high"
      />
    </div>
    <div class="joy-sticker">
      <img src={app.icon} width="45" height="45" alt="" />
      <span>{content.sticker}</span>
    </div>
  </div>
) : (
  <div class:list={['app-brand-scene', { compact }]}>
    <img src={app.icon} width="240" height="240" alt={app.brandName} />
    <p>{content.sticker}</p>
  </div>
)}

<style>
  .app-brand-scene {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1.5rem;
    min-height: 390px;
    width: 100%;
    padding: 2rem 1rem;
    border-radius: 2rem;
    background: radial-gradient(
      ellipse at center,
      #ffe2b7,
      #fff5e8 66%,
      transparent
    );
  }
  .app-brand-scene img {
    width: min(240px, 60%);
    height: auto;
    filter: drop-shadow(0 18px 24px #a84c2520);
  }
  .app-brand-scene p {
    margin: 0;
    font-size: 1.1rem;
    color: #70452c;
  }
  .app-brand-scene.compact {
    min-height: 340px;
  }
  @media (max-width: 600px) {
    .app-brand-scene,
    .app-brand-scene.compact {
      min-height: 280px;
    }
  }
</style>
