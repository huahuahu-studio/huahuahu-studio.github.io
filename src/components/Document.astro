---
import { copy, route, email, documentKeys, type Language } from '../data/site';
import type { DocumentContent } from '../data/documents';
import type { AppConfig } from '../data/apps';
interface Props {
  lang: Language;
  document: DocumentContent;
  app?: AppConfig;
  active?: string;
}
const { lang, document, app, active } = Astro.props;
const t = copy[lang];
const a = app?.content[lang];
---

<header class="document-heading wrap">
  <a
    class="breadcrumb"
    href={app ? route(lang, 'apps/' + app.id) : route(lang)}
  >
    ← {a ? a.back : t.home}
  </a>
  <p class="eyebrow orange">
    {app ? app.brandName.toUpperCase() + ' / ' : 'HUAHUAHU STUDIO / '}
    {active?.toUpperCase()}
  </p>
  <h1>{document.title}</h1>
  <p class="lead">{document.lead}</p>
  <p class="document-meta">
    {active === 'privacy' && !app ? t.websiteUpdated : t.updated}
  </p>
</header>
<div class="document-layout wrap">
  <nav class="document-nav" aria-label={t.contents}>
    <p class="eyebrow">{t.contents}</p>
    {document.sections.map((section) => (
      <a href={'#' + section.id}>{section.title}</a>
    ))}
    {app && (
      <div class="related-docs">
        {documentKeys.map((key) => (
          <a
            href={route(lang, 'apps/' + app.id + '/' + key)}
            aria-current={active === key ? 'page' : undefined}
          >
            {t[key]}
          </a>
        ))}
      </div>
    )}
  </nav>
  <article class="document-content">
    {document.sections.map((section) => (
      <section id={section.id}>
        <h2>{section.title}</h2>
        {section.paragraphs.map((p) => (
          <p>{p}</p>
        ))}
        {section.bullets && (
          <ul>
            {section.bullets.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )}
      </section>
    ))}
    {active === 'terms' && a?.termsLink && (
      <p>
        <a class="text-link" href={a.termsLink.href}>
          {a.termsLink.label} ↗
        </a>
      </p>
    )}
    {active === 'privacy' && a?.privacyLink && (
      <p>
        <a class="text-link" href={a.privacyLink.href}>
          {a.privacyLink.label} ↗
        </a>
      </p>
    )}
    {active === 'privacy' && !app && (
      <p>
        <a class="text-link" href="https://www.cloudflare.com/privacypolicy/">
          {lang === 'zh'
            ? '阅读 Cloudflare 隐私政策'
            : 'Read Cloudflare’s Privacy Policy'}{' '}
          ↗
        </a>{' '}
        ·{' '}
        <a
          class="text-link"
          href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement"
        >
          {lang === 'zh'
            ? '阅读 GitHub 隐私声明'
            : 'Read GitHub’s Privacy Statement'}{' '}
          ↗
        </a>
      </p>
    )}
    {active === 'privacy' && app && (
      <p>
        <a class="text-link" href={route(lang, 'apps/' + app.id + '/data')}>
          {t.data} →
        </a>
      </p>
    )}
    <aside class="document-contact">
      <h2>{t.question}</h2>
      <p>
        {t.emailAction}：<a href={'mailto:' + email}>{email}</a>
      </p>
    </aside>
  </article>
</div>
