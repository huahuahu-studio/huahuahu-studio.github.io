---
import { copy, route, email, type Language } from '../data/site';
import type { AppConfig } from '../data/apps';
import PhoneScene from './PhoneScene.astro';
interface Props {
  lang: Language;
  apps: readonly AppConfig[];
  featuredApp: AppConfig;
}
const { lang, apps, featuredApp } = Astro.props;
const t = copy[lang];
---

<section class="home-hero wrap">
  <div class="hero-copy">
    <p class="eyebrow">
      <span class="status-dot"></span>
      {t.eyebrow}
    </p>
    <h1>
      {t.heroLine}
      <br />
      <em>{t.heroAccent}</em>
    </h1>
    <p class="hero-description">{t.heroDescription}</p>
    <a class="button button-dark" href="#apps">
      {t.explore}
      <span aria-hidden="true">↘</span>
    </a>
    <p class="hero-note">
      <span aria-hidden="true">✳</span>
      {t.heroNote}
    </p>
  </div>
  <PhoneScene lang={lang} app={featuredApp} />
</section>
<section id="apps" class="apps-section wrap">
  <div class="section-heading">
    <div>
      <p class="eyebrow orange">01 / OUR APPS</p>
      <h2>{t.selected}</h2>
    </div>
    <p>{t.selectedNote}</p>
  </div>
  {apps.map((app) => {
    const a = app.content[lang];
    return (
      <article class="app-feature">
        <div class="app-feature-copy">
          <div class="app-icon">
            <img src={app.icon} alt="" width="72" height="72" />
          </div>
          <p class="eyebrow">
            {a.appCategory} <span aria-hidden="true">/</span>{' '}
            {app.platformBadge}
          </p>
          <h3>
            {a.name}
            {a.secondaryName && (
              <span class="latin-name">{a.secondaryName}</span>
            )}
          </h3>
          <p>{a.appDescription}</p>
          <a class="text-link" href={route(lang, 'apps/' + app.id)}>
            {a.learn}
            <span aria-hidden="true">↗</span>
          </a>
          <div class="app-quick-links">
            <a href={route(lang, 'apps/' + app.id + '/privacy')}>{t.privacy}</a>
            <a href={route(lang, 'apps/' + app.id + '/support')}>{t.support}</a>
          </div>
        </div>
        <div class="app-feature-art">
          <PhoneScene lang={lang} app={app} compact />
          <span class="art-caption">{a.artCaption}</span>
        </div>
      </article>
    );
  })}
</section>
<section class="principles wrap">
  <p class="eyebrow orange">02 / {t.principleLabel}</p>
  <h2>{t.principleTitle}</h2>
  <div class="principles-grid">
    {t.principles.map((p, i) => (
      <div>
        <span class="principle-number">0{i + 1}</span>
        <h3>{p.title}</h3>
        <p>{p.text}</p>
      </div>
    ))}
  </div>
</section>
<section class="hello-section wrap">
  <span class="hello-symbol" aria-hidden="true">
    ✳
  </span>
  <div>
    <h2>{t.helloTitle}</h2>
    <p>{t.helloText}</p>
    <a class="text-link" href={'mailto:' + email}>
      {email}
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>
